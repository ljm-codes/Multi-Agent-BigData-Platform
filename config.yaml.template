# ---------------- ① 基础服务 ----------------
server:
  host: 0.0.0.0
  port: 8000

logging:
  level: 'DEBUG'
  file_path: './log'
  formatter: '%(asctime)s [%(threadName)s - %(thread)d] %(levelname)s %(filename)s [%(funcName)s/%(lineno)d] %(message)s'
  create_file: true
  max_bytes: 5MB
  backup_count: 2

redis:
  host: localhost
  port: 6379
  password: '123456'      # 本地开发默认值，请按实际环境修改
  db: 0
  max_connections: 20

AMQP:
  rabbitmq:
    username: your_username
    password: 'your_password'
    host: localhost        # 你的 RabbitMQ 地址（原为局域网 VM 地址，已脱敏）
    port: 5672
    virtual_host: /
    heartbeat: 600
    connection_attempts: 3
    retry_delay: 5

huggingface:
  mirror: true                 # 使用 hf-mirror.com 镜像（国内网络建议开启）
  download_dir: ./huggingface_cache

# ---------------- ③ 模型与记忆框架参数（★重点） ----------------
model:
  # 主 Agent / 子专家共用的对话模型（OpenAI 兼容协议，凭据在 .env 中）
  name: 'deepseek-v4-flash'
  # 可选：HF 分词器 id，用于更精确的 token 计数（不配则降级为字数/3.3 估算）
  # huggingface_id: 'Qwen/Qwen2.5-7B-Instruct'
  params:
    temperature: 0.8
    extra_body:
      thinking:
        type: 'disabled'
  vision:
    name: 'qwen3.7-plus'       # 视觉模型（以图搜商品等场景）

  # ★ 记忆框架 —— 应用场景（职业）选择
  #   BalancedMultiDimensionMemory 内置三套遗忘/巩固参数预设：
  #     collaborative creation  协同创作：记忆久、遗忘慢（长时记忆优先）
  #     customer service        智能客服：短时记忆、快遗忘、重语义相关性（本仓库默认）
  #     accompany               陪伴型：介于两者之间
  #     customize               完全自定义：必须同时填写下面的 kwargs
  vocation:
    name: 'customer service'
    # kwargs:  # 仅 customize 模式需要。结构与代码 time_memory.py 的 _VOCATION_PARAM_MAP 一致：
    #   M(Δt):                 # 记忆成熟度曲线：M(Δt)=1-exp(-(Δt/τ_m)^c)
    #     τ_m: 600             #   τ_m：时间尺度（秒），越大"成熟"越慢，切片越晚触发
    #     c: 0.5               #   形状系数（c<1 先快后慢）
    #   T(m):                  # 遗忘曲线（艾宾浩斯参数化）：T(m)=exp(-(Δt/τ)^c)
    #     τ: 43200             #   τ：时间尺度（秒），越大遗忘越慢（τ 时记忆降至约 37%）
    #     c: 0.5               #   形状系数
    #   slice: 0.7             # 切片触发阈值（0~1）：最早消息成熟度 M ≥ 该值 → 开始 LLM 主题分片
    #   long-term: 0.9         # 归纳触发阈值（0~1）：片段成熟度 ≥ 该值 → 纳入增量总结

  # ★ 记忆框架 —— 分片/总结用模型与触发模式
  #   （记忆的"切主题"和"归纳画像"都由这个模型完成，可与对话模型不同）
  summary:
    name: 'deepseek-v4-flash'
    kwargs:
      temperature: 1.3
      extra_body:
        thinking:
          type: 'disabled'
      profile:
        # 记录模型的最大输入 token 数（fraction 模式的基准，请与模型实际能力一致）
        max_input_tokens: 12800
    # 触发"工作记忆裁剪 + 记忆检索注入"的模式，三选一：
    #   fraction  按占比：累计 token ≥ max_input_tokens × trigger_threshold（建议阈值 ≥ 0.7）
    #   tokens    按条数：累计 token ≥ trigger_threshold（整数，建议 ≥ 10000）
    #   messages  按消息数：累计消息 ≥ trigger_threshold（整数，建议 ≥ 50）
    pattern: 'fraction'
    trigger_threshold: 0.8

# ---------------- ④ Hadoop / YARN ----------------
# Tools/ 下的检测工具读这一段。地址可以不带 scheme(形如 node1:8088), 会自动补 http://;
# 整段缺失或某项没配时, 代码里各有一个内置默认值兜底, 所以这里不是必填。
hadoop:
  yarn:
    manager: node1:8088            # ResourceManager 地址
    proxy: node1:8089              # WebAppProxy 地址(checker 走它取应用数据)
    poll_interval: 30              # 轮询间隔, 单位秒
    max_job_timeout: 1800          # 作业最大运行时间, 单位秒, 超过判定为超时
    spark:
      # 数据倾斜判定阈值: 取 shuffle 读记录数的 max/median
      # 默认值的依据是实测(tests/skew_threshold_sweep.py 可复现):
      #   健康作业检出比稳定在 2.00(连跑 3 次一致), 真实倾斜 5:1 -> 5.27,
      #   10:1 -> 9.29, 20:1 -> 25.50 —— 映射基本准确。
      # 所以 5.0 约等于真实 5:1(健康作业有 2.5 倍余量), 10.0 约等于真实 10:1。
      skew_warning_ratio: 5.0
      skew_error_ratio: 10.0

      # ---- 内核 OOM 的检测(节点内存) ----
      # 内核 OOM 杀掉的容器, removeReason 和外部 `kill -9` **逐字节相同**
      # (只有 "Killed by external signal", 没有任何内存文本): 137 在 NodeManager 里
      # 就是"被杀"分支, 信号是谁发的从来没被记录。executor 层和 task 层都分不开。
      # 唯一的区分性信号在**节点侧**: 内核出手时整机内存是满的(NM 实测的 memUtilization)。
      # 2026-09-14 实测同一台 node3: 内核 OOM 死前 95.19%(3109/3267MB) vs 外部 kill 全程
      # 最大 57.23%, 而两者的 removeReason 一模一样。
      # 阈值要按环境标定 —— 本集群基线就有 52~69%(机器小、daemon 占得多)。
      node_mem_suspect_ratio: 85.0      # 节点内存利用率超过多少算"被打满"
      node_mem_sample_interval: 5       # 采样间隔(秒): 该值瞬时, 容器一死就还回去了
      node_mem_lookback_seconds: 90     # 判定时从 executor 死亡时刻往前回看多久
      node_mem_max_samples: 240         # 每节点保留的样本数(5s × 240 ≈ 20 分钟)

      # P2 的执行内存水位是按心跳采样的(默认 10s), 短任务作业读到的只是噪声 ——
      # 低于执行池这个比例就当"没采到", 而不是"用得太少"。依据见 tests/spark/README.md
      p2_sampling_blind_ratio: 0.01

      # spark-submit 提交端：二进制、Python、预上传 jars 归档（archive 可留空）
      submit_bin: /export/server/spark3/bin/spark-submit
      python: /export/server/miniconda3/envs/spark_study/bin/python3
      archive: hdfs://node1:8020/user/hadoop/spark-libs.zip
  hdfs:
    webhdfs:
      url: http://node1:8030
      user: hadoop

agent:
  DDA:
    java_maven_lib_dir: ~/.m2/repository
  DAA:
    python_lib_dir: /path/to/spark_sandbox/Lib/site-packages
    test_python: /path/to/spark_sandbox/python.exe
    spark_test_master: local[*]

# ---------------- ⑤ 数据存储与告警 ----------------
databases:
  mysql:                     # 商城业务数据（用户/商品/订单，当前以测试桩数据运行）
    host: localhost
    port: 3306
    user: root
    password: '123456'       # 本地开发默认值
    db: fireflymall
  postgres:                  # LangGraph Checkpointer / Store 的生产存储
    enabled: true            # false 时退回 InMemory，仅本地调试
    host: localhost
    port: 5432
    user: postgres
    password: '123456'
    db: multiagentbigdataplatform
  rag:
    sqlite:                  # ★ 记忆片段向量库（sqlite-vec），记忆框架的存储层
      db_url: './database/test1.db'
    es:                      # 预留：ES 检索（商品索引）
      db_url: 'http://localhost:9200'
      index_name: 'goods'
      username: 'elastic'
      password: '123456'
    milvus:                  # FAQ 知识库向量检索
      collection_name: firefly_mall_faq
      primary_field: pk
      metadata_field: metadata
      text_field: text
      conn_args:
        uri: http://localhost:19530
        token: root:Milvus
        db_name: firefly_mall
      index_params:
        index_type: IVF_FLAT
        metric_type: COSINE
        params:
          nlist: 128
      search_params:
        metric_type: COSINE
        params:
          nprobe: 10
      level: Strong
      drop_old: false

# 邮箱告警（分片/总结异常、RabbitMQ 消息滞留超时等场景会发信到 receiver）
email:
  smtp: 'smtp.qq.com'
  port: 465
  sender: 'your_email@qq.com'
  sender_name: '智能客服告警'
  receiver:
    - 'your_email@qq.com'
